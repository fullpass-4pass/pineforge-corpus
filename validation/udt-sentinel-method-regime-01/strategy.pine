// PineForge Corporate Strategy: Sentinel UDT Method
// Typed methods remain local; this strategy intentionally does not nest a typed
// UDT method inside request.security.
strategy("PineForge — Sentinel UDT Method", overlay=true,
     initial_capital=100000, currency=currency.USD,
     default_qty_type=strategy.percent_of_equity, default_qty_value=6,
     pyramiding=0, commission_type=strategy.commission.percent,
     commission_value=0.05, slippage=1,
     margin_long=100, margin_short=100,
     process_orders_on_close=false, calc_on_order_fills=false)

type RegimeState
    float center
    float strength
    bool bullish

method refresh(RegimeState self, float nextCenter, float nextStrength) =>
    self.center := nextCenter
    self.strength := nextStrength
    self.bullish := close > nextCenter and nextStrength > 50.0
    self

method permitsLong(RegimeState self, float minimumStrength) =>
    self.bullish and self.strength >= minimumStrength

emaLength = input.int(36, "Center EMA", minval=3, group="Signal")
rsiLength = input.int(15, "Strength RSI", minval=2, group="Signal")
minimumStrength = input.float(54.0, "Minimum Strength", minval=50, maxval=90, group="Signal")
atrLength = input.int(14, "ATR Length", minval=2, group="Risk")
stopAtr = input.float(2.1, "Stop ATR", minval=0.5, step=0.1, group="Risk")

centerValue = ta.ema(close, emaLength)
strengthValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)
var RegimeState state = RegimeState.new(na, 0.0, false)
state := state.refresh(centerValue, strengthValue)

enterSignal = ta.crossover(strengthValue, minimumStrength) and state.permitsLong(minimumStrength)
exitSignal = ta.crossunder(strengthValue, 48.0) or close < state.center

if enterSignal
    strategy.entry("Sentinel Long", strategy.long)

if strategy.position_size > 0 and exitSignal
    strategy.close("Sentinel Long", comment="Regime changed")

if strategy.position_size > 0
    strategy.exit("Sentinel Guard", from_entry="Sentinel Long",
         stop=strategy.position_avg_price - atrValue * stopAtr)

plot(state.center, "State Center", color=state.bullish ? color.green : color.red)
